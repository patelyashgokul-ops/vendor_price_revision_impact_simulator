<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_ap21_request" model="ir.ui.view"><field name="name">vpr.vendor.planning.request</field><field name="model">vendor.price.revision.approval.request</field><field name="inherit_id" ref="view_ap_request_form"/><field name="arch" type="xml">
 <xpath expr="//header" position="inside"><button name="action_open_vendor_application_intent" type="object" string="Declare Vendor Rule Intent" groups="group_vpr_purchase_manager,group_vpr_finance_manager" invisible="state not in ['draft','blocked','ready_to_submit']"/><button name="action_open_application_dry_run" type="object" string="Read-Only Vendor Dry-Run" groups="group_vpr_purchase_manager,group_vpr_finance_manager"/><button name="action_view_application_plans" type="object" string="Planning History"/></xpath>
 <xpath expr="//notebook" position="inside"><page string="Vendor Application Scope"><div class="alert alert-info">Declare rule intent before submission. Independent approval freezes it. Dry-run never changes vendor prices.</div><field name="vendor_application_scope" readonly="1"/><field name="application_plan_ids" readonly="1"/></page></xpath>
 </field></record>
 <record id="view_ap21_intent" model="ir.ui.view"><field name="name">vpr.vendor.intent.input</field><field name="model">vendor.price.revision.application.intent.wizard</field><field name="arch" type="xml"><form string="Declare One Exact Vendor Rule Before Approval"><group><field name="request_id" readonly="1"/><field name="batch_id" invisible="1"/><field name="row_id" domain="[('batch_id','=',batch_id)]"/><field name="operation"/><field name="target_id" invisible="operation != 'update'" required="operation == 'update'"/><field name="target_uom_id"/><field name="allow_discount_change"/><field name="vendor_component"/><field name="calendar_timezone"/></group><group string="Explicit Creation Metadata" invisible="operation != 'create'"><field name="delay"/><field name="sequence"/><field name="product_code"/><field name="product_name"/></group><field name="reason"/><footer><button name="action_declare" type="object" string="Record Draft Intent" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
 <record id="view_ap21_plan_list" model="ir.ui.view"><field name="name">vpr.application.plan.list</field><field name="model">vendor.price.revision.application.plan</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="name"/><field name="company_id"/><field name="request_id"/><field name="version"/><field name="historical_readiness"/><field name="current_readiness"/><field name="prepared_by"/><field name="prepared_at"/></list></field></record>
 <record id="view_ap21_plan_form" model="ir.ui.view"><field name="name">vpr.application.plan.form</field><field name="model">vendor.price.revision.application.plan</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_revalidate_application_plan" type="object" string="Run Fresh Read-Only Validation" groups="group_vpr_purchase_manager,group_vpr_finance_manager"/></header><sheet><div class="alert alert-warning">PLANNED ONLY — NO VENDOR PRICES APPLIED. Historical readiness never replaces current approval and target checks.</div><group><field name="name"/><field name="company_id"/><field name="request_id"/><field name="version"/><field name="previous_id"/><field name="prepared_by"/><field name="prepared_at"/><field name="historical_readiness"/><field name="current_readiness"/><field name="source_fingerprint"/><field name="target_fingerprint"/></group><notebook><page string="Before / After"><field name="line_ids" readonly="1"/></page><page string="Conflicts"><field name="issue_ids" readonly="1"/></page><page string="Immutable Dry-Run Evidence"><field name="fingerprint"/><field name="evidence"/></page></notebook></sheet></form></field></record>
 <record id="view_ap21_line_list" model="ir.ui.view"><field name="name">vpr.application.line.list</field><field name="model">vendor.price.revision.application.plan.line</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="plan_id"/><field name="company_id"/><field name="row_id"/><field name="product_id"/><field name="target_id"/><field name="operation"/><field name="current_price"/><field name="current_currency_id"/><field name="current_uom_id"/><field name="approved_price"/><field name="approved_currency_id"/><field name="approved_uom_id"/><field name="approved_moq"/><field name="effective_start"/><field name="effective_end"/><field name="price_delta"/><field name="before_values"/><field name="planned_after_values"/><field name="conflicts"/></list></field></record>
 <record id="view_ap21_line_form" model="ir.ui.view"><field name="name">vpr.application.line.form</field><field name="model">vendor.price.revision.application.plan.line</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><div class="alert alert-info">Immutable analytical comparison. A missing target ID means a planned new row, not an existing supplier price.</div><group><field name="plan_id"/><field name="company_id"/><field name="row_id"/><field name="product_id"/><field name="target_id"/><field name="operation"/></group><group><group string="Observed Before"><field name="before_values"/></group><group string="Approved Planned After"><field name="planned_after_values"/></group></group><group><field name="changed_fields"/><field name="conflicts"/><field name="source_fingerprint"/><field name="target_fingerprint"/></group><field name="evidence"/></sheet></form></field></record>
 <record id="view_ap21_issue_list" model="ir.ui.view"><field name="name">vpr.application.issue.list</field><field name="model">vendor.price.revision.application.plan.issue</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="plan_id"/><field name="company_id"/><field name="row_id"/><field name="code"/><field name="severity"/><field name="description"/></list></field></record>
 <record id="view_ap21_issue_search" model="ir.ui.view"><field name="name">vpr.application.conflict.search</field><field name="model">vendor.price.revision.application.plan.issue</field><field name="arch" type="xml"><search><field name="code"/><field name="plan_id"/><filter name="ambiguous" string="Ambiguous" domain="[('code','=','AMBIGUOUS_TARGET')]"/><filter name="shared" string="Shared Rule" domain="[('code','=','SHARED_RECORD_SCOPE_CONFLICT')]"/><filter name="variant" string="Variant Scope" domain="[('code','=','TEMPLATE_VARIANT_SCOPE_CONFLICT')]"/><filter name="overlap" string="Overlapping Rule" domain="[('code','=','OVERLAPPING_EFFECTIVE_RULE')]"/><filter name="target" string="Target Changed" domain="[('code','=','TARGET_CHANGED_SINCE_APPROVAL')]"/><filter name="expired" string="Approval Expired" domain="[('code','=','APPROVAL_EXPIRED')]"/></search></field></record>
 <record id="action_ap21_plans" model="ir.actions.act_window"><field name="name">Vendor Application Plans — Read Only</field><field name="res_model">vendor.price.revision.application.plan</field><field name="view_mode">list,form</field></record>
 <record id="action_ap21_conflicts" model="ir.actions.act_window"><field name="name">Vendor Application Conflicts</field><field name="res_model">vendor.price.revision.application.plan.issue</field><field name="view_mode">list</field></record>
 <menuitem id="menu_ap21_planning" name="Price Application Planning" parent="menu_approval_foundation" sequence="75" groups="group_vpr_purchase_manager,group_vpr_finance_manager,group_vpr_director,group_vpr_auditor"/>
 <menuitem id="menu_ap21_plans" name="Read-Only Dry-Run Plans" parent="menu_ap21_planning" action="action_ap21_plans" sequence="10"/>
 <menuitem id="menu_ap21_conflicts" name="Planning Conflicts" parent="menu_ap21_planning" action="action_ap21_conflicts" sequence="20"/>
</odoo>
