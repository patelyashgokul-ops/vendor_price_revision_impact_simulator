<record id="view_supply_terms_form" model="ir.ui.view"><field name="name">view_supply_terms_form</field><field name="model">vendor.price.revision.supply.terms</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_open_verification" type="object" string="Independent Terms Verification" invisible="state != 'proposed'" groups="vendor_price_revision_impact_simulator.group_vpr_purchase_manager"/></header><sheet><group><field name="batch_id"/><field name="warehouse_id"/><field name="po_line_id"/><field name="classification"/><field name="state"/><field name="proposed_by"/><field name="proposed_at"/><field name="reason"/><field name="verified_by"/><field name="verified_at"/><field name="verification_reason"/><field name="terms_digest"/></group><field name="terms_evidence"/></sheet></form></field></record>
