<record id="view_batch_supply" model="ir.ui.view"><field name="name">vpr.batch.supply</field><field name="model">vendor.price.revision.import.batch</field><field name="inherit_id" ref="view_import_batch_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_open_supply_collector" type="object" string="Collect Supply / Review Terms" groups="vendor_price_revision_impact_simulator.group_vendor_price_revision_user" invisible="state != 'extracted'"/></xpath><xpath expr="//notebook" position="inside"><page string="Supply Evidence"><div class="alert alert-info" role="status">Current stock and supplier-unreceived commitments. Reservation is subtracted once. No customer allocation or financial exposure is calculated. Blank quantities and costs mean unavailable. Historical snapshots require a current-source check.</div><field name="supply_snapshot_ids" readonly="True"><list create="false" edit="false" delete="false"><field name="collected_at"/><field name="warehouse_ids"/><field name="version"/><field name="contains_costs"/><field name="state"/><field name="quantity_verified"/><field name="cost_state"/></list></field></page></xpath></field></record>
