<odoo>
 <record id="view_recommendation_list" model="ir.ui.view"><field name="name">vpr.recommendation.list</field><field name="model">vendor.price.revision.recommendation</field><field name="arch" type="xml"><list create="false" edit="false" delete="false" limit="20"><field name="name"/><field name="company_id"/><field name="scenario_id"/><field name="currency_id"/><field name="state"/><field name="complete"/><field name="required_revenue"/><field name="revenue_gap"/><field name="supplier_ceiling"/><field name="version"/><field name="collected_at"/></list></field></record>
 <record id="view_recommendation_form" model="ir.ui.view"><field name="name">vpr.recommendation.form</field><field name="model">vendor.price.revision.recommendation</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_revalidate" type="object" string="Revalidate / Regenerate" groups="vendor_price_revision_impact_simulator.group_vpr_finance_manager"/><button name="action_compare_options" type="object" string="Compare Separate Options"/><button name="action_open_review" type="object" string="Record Commercial Review" groups="vendor_price_revision_impact_simulator.group_vpr_finance_manager"/><button name="action_open_source" type="object" string="Source Vendor Scenario"/></header><sheet><div class="alert alert-warning" role="status">Recommendations only. Financial verification does not grant customer permission or management approval. Benefits are conditional, never realized cash. Alternative options must not be added together. Stored history requires current-source revalidation.</div><group><field name="name"/><field name="batch_id"/><field name="company_id"/><field name="scenario_id"/><field name="scenario_result_id"/><field name="currency_id"/><field name="state"/><field name="current_state"/><field name="complete"/><field name="version"/><field name="previous_id"/><field name="required_revenue"/><field name="revenue_gap"/><field name="supplier_ceiling"/><field name="actor_id"/><field name="collected_at"/></group><notebook><page string="Customer Lines and Eligibility"><field name="line_ids"/></page><page string="Separate Commercial Alternatives"><field name="option_ids"/></page><page string="Review History"><field name="review_ids"/></page><page string="Objective and Financial Evidence"><field name="summary"/><field name="scope"/><field name="controls"/></page><page string="Source Versions and Policies"><field name="provenance"/><field name="fingerprint"/></page></notebook></sheet></form></field></record>
 <record id="view_recommendation_line_list" model="ir.ui.view"><field name="name">vpr.recommendation.line.list</field><field name="model">vendor.price.revision.recommendation.line</field><field name="arch" type="xml"><list create="false" edit="false" delete="false" limit="40"><field name="sale_line_id"/><field name="customer_id"/><field name="product_id"/><field name="eligibility"/><field name="eligible_qty"/><field name="comparison_uom_id"/><field name="financial_net_unit_reference"/><field name="recommended_net_price"/><field name="display_price_unit"/><field name="sales_currency_id"/><field name="sales_uom_id"/></list></field></record>
 <record id="view_recommendation_line_form" model="ir.ui.view"><field name="name">vpr.recommendation.line.form</field><field name="model">vendor.price.revision.recommendation.line</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_open_source" type="object" string="Authorized SO / Quotation"/></header><sheet><group><field name="recommendation_id"/><field name="sale_line_id"/><field name="customer_id"/><field name="product_id"/><field name="eligibility"/><field name="eligible_qty"/><field name="comparison_uom_id"/><field name="financial_net_unit_reference"/><field name="recommended_net_price"/><field name="display_price_unit"/><field name="sales_currency_id"/><field name="sales_uom_id"/></group><field name="values"/></sheet></form></field></record>
 <record id="view_recommendation_option_list" model="ir.ui.view"><field name="name">vpr.recommendation.option.list</field><field name="model">vendor.price.revision.recommendation.option</field><field name="arch" type="xml"><list create="false" edit="false" delete="false" limit="40" default_order="priority,id"><field name="recommendation_id"/><field name="kind"/><field name="feasibility"/><field name="priority"/><field name="additional_net_revenue"/><field name="reduced_procurement_cost"/><field name="projected_profit_improvement"/><field name="remaining_target_gap"/><field name="risk_status"/></list></field></record>
 <record id="view_recommendation_option_form" model="ir.ui.view"><field name="name">vpr.recommendation.option.form</field><field name="model">vendor.price.revision.recommendation.option</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><group><field name="recommendation_id"/><field name="kind"/><field name="feasibility"/><field name="priority"/><field name="additional_net_revenue"/><field name="reduced_procurement_cost"/><field name="projected_profit_improvement"/><field name="remaining_target_gap"/><field name="risk_status"/></group><field name="values"/></sheet></form></field></record>
 <record id="view_recommendation_review_form" model="ir.ui.view"><field name="name">vpr.recommendation.review.form</field><field name="model">vendor.price.revision.recommendation.review</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><group><field name="recommendation_id"/><field name="option_id"/><field name="event"/><field name="reason"/><field name="evidence"/><field name="actor_id"/><field name="collected_at"/></group></sheet></form></field></record>
 <record id="view_recommendation_wizard" model="ir.ui.view"><field name="name">vpr.recommendation.wizard</field><field name="model">vendor.price.revision.recommendation.wizard</field><field name="arch" type="xml"><form><div class="alert alert-info" role="status">Eligible subsets use the frozen comparison UoM. Minimum/maximum net prices use the original sales currency and sales UoM. Inputs can restrict existing verified rights; they cannot grant permission to amend a customer price.</div><group><field name="scenario_id" readonly="1"/><field name="baseline_id" readonly="1"/><field name="objective"/><field name="alternative_ids" domain="[('baseline_id','=',baseline_id)]"/></group><field name="line_ids"><list editable="bottom"><field name="sale_line_id"/><field name="eligible_qty"/><field name="max_net_source_unit"/><field name="min_net_source_unit"/><field name="conditions"/><field name="reason"/></list></field><footer><button name="action_generate" type="object" string="Generate Analytical Recommendations" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
 <record id="view_recommendation_review_wizard" model="ir.ui.view"><field name="name">vpr.recommendation.review.wizard</field><field name="model">vendor.price.revision.recommendation.review.wizard</field><field name="arch" type="xml"><form><group><field name="recommendation_id" readonly="1"/><field name="option_id" domain="[('recommendation_id','=',recommendation_id)]"/><field name="event"/><field name="reason"/><field name="evidence"/></group><footer><button name="action_record" type="object" string="Retain Review Evidence"/><button special="cancel" string="Cancel"/></footer></form></field></record>
 <record id="view_scenario_recommendation_button" model="ir.ui.view"><field name="name">vpr.scenario.recommendation.button</field><field name="model">vendor.price.revision.scenario</field><field name="inherit_id" ref="view_scenario_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_open_recommendations" type="object" string="Commercial Recommendations" groups="vendor_price_revision_impact_simulator.group_vpr_finance_manager"/></xpath></field></record>
 <record id="view_recommendation_policy" model="ir.ui.view"><field name="name">vpr.recommendation.policy</field><field name="model">vendor.price.revision.config</field><field name="inherit_id" ref="view_vpr_config_form"/><field name="arch" type="xml"><xpath expr="//field[@name='additional_cost_policy']" position="after"><field name="recommendation_draft_policy" readonly="state != 'draft'"/><field name="recommendation_recovery_scope" readonly="state != 'draft'"/><field name="recommendation_max_uplift_percent" readonly="state != 'draft'"/></xpath></field></record>
 <record id="action_recommendations" model="ir.actions.act_window"><field name="name">Repricing Recommendations</field><field name="res_model">vendor.price.revision.recommendation</field><field name="view_mode">list,form</field></record>
 <record id="action_recommendation_options" model="ir.actions.act_window"><field name="name">Commercial Options - Not Additive</field><field name="res_model">vendor.price.revision.recommendation.option</field><field name="view_mode">list,form</field></record>
 <record id="action_recommendation_reviews" model="ir.actions.act_window"><field name="name">Commercial Review Evidence</field><field name="res_model">vendor.price.revision.recommendation.review</field><field name="view_mode">list,form</field></record>
