 <menuitem id="menu_recommendations" name="Repricing Recommendations" parent="menu_commercial_recommendations" action="action_recommendations" sequence="10"/>
 <menuitem id="menu_recommendation_options" name="Commercial Options" parent="menu_commercial_recommendations" action="action_recommendation_options" sequence="20"/>
