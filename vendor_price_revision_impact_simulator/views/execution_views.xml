<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_ex22_plan" model="ir.ui.view"><field name="name">vpr.plan.operational.confirmation</field><field name="model">vendor.price.revision.application.plan</field><field name="inherit_id" ref="view_ap21_plan_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><field name="can_execute22" invisible="1"/><button name="action_open_execution_confirmation" type="object" string="Apply Exact Approved Vendor Prices" groups="group_vpr_pricing_operator" invisible="not can_execute22"/></xpath><xpath expr="//sheet" position="inside"><group string="Operational Execution History"><field name="execution_ids" readonly="1"/></group></xpath></field></record>
 <record id="view_ex22_confirm" model="ir.ui.view"><field name="name">vpr.confirm.exact.price.execution</field><field name="model">vendor.price.revision.application.confirmation</field><field name="arch" type="xml"><form string="Confirm Operational Vendor Pricelist Changes"><div class="alert alert-warning">This deliberate action changes operational Vendor Pricelist records for this exact approved scope. Existing RFQs, Purchase Orders, Sales Orders, stock and accounting are not repriced. All changes and audit evidence must commit together.</div><group><field name="plan_id"/><field name="company_id"/><field name="vendor_id"/><field name="request_id"/><field name="expected_fingerprint"/></group><field name="scope"/><field name="confirmation"/><footer><button name="action_confirm" type="object" string="Confirm Exact Application" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
 <record id="view_ex22_list" model="ir.ui.view"><field name="name">vpr.execution.list</field><field name="model">vendor.price.revision.application.execution</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="name"/><field name="company_id"/><field name="request_id"/><field name="plan_id"/><field name="operator_id"/><field name="state"/><field name="executed_at"/><field name="create_count"/><field name="update_count"/><field name="no_change_count"/><field name="current_target_status"/></list></field></record>
 <record id="view_ex22_form" model="ir.ui.view"><field name="name">vpr.execution.immutable.receipt</field><field name="model">vendor.price.revision.application.execution</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_show_execution_verification" type="object" string="Check Current Recorded Targets"/></header><sheet><div class="alert alert-info">Immutable operational receipt. VERIFIED is visible only after the originating transaction commits. Verification time is not a database commit timestamp. Future-dated rules are not active before their approved dates. Financial forecasts are not realized outcomes.</div><group><field name="name"/><field name="company_id"/><field name="request_id"/><field name="authorization_id"/><field name="plan_id"/><field name="operator_id"/><field name="state"/><field name="verified_at"/><field name="executed_at"/><field name="current_target_status"/><field name="create_count"/><field name="update_count"/><field name="no_change_count"/><field name="verified_line_count"/></group><notebook><page string="Verified Line Ledger"><field name="line_ids" readonly="1"/></page><page string="Immutable Audit"><field name="execution_key"/><field name="transaction_id"/><field name="source_fingerprint"/><field name="target_fingerprint_before"/><field name="target_fingerprint_after"/><field name="fingerprint"/><field name="evidence"/></page></notebook></sheet></form></field></record>
 <record id="view_ex22_line_list" model="ir.ui.view"><field name="name">vpr.execution.line.list</field><field name="model">vendor.price.revision.application.execution.line</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="execution_id"/><field name="company_id"/><field name="row_id"/><field name="plan_line_id"/><field name="operation"/><field name="target_id"/><field name="before_values"/><field name="approved_after_values"/><field name="observed_after_values"/></list></field></record>
 <record id="action_ex22_receipts" model="ir.actions.act_window"><field name="name">Verified Vendor Price Executions</field><field name="res_model">vendor.price.revision.application.execution</field><field name="view_mode">list,form</field></record>
 <menuitem id="menu_ex22_receipts" name="Application Executions and History" parent="menu_ap21_planning" action="action_ex22_receipts" sequence="30" groups="group_vpr_pricing_operator,group_vpr_purchase_manager,group_vpr_finance_manager,group_vpr_director,group_vpr_auditor"/>
 <record id="view_ex22_policy" model="ir.ui.view"><field name="name">vpr.execution.company.separation</field><field name="model">vendor.price.revision.config</field><field name="inherit_id" ref="view_vpr_config_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Application Operator Separation"><field name="application_distinct_maker" readonly="state != 'draft'"/><field name="application_distinct_approver" readonly="state != 'draft'"/><div>Execution additionally requires explicit Pricing Operator membership, authorized Purchase/Finance source access and native operation permissions. Published policy versions remain immutable.</div></page></xpath></field></record>
 <record id="view_ex22_boundary_input" model="ir.ui.view"><field name="name">vpr.explicit.future.boundary.intent</field><field name="model">vendor.price.revision.application.intent.wizard</field><field name="inherit_id" ref="view_ap21_intent"/><field name="arch" type="xml"><xpath expr="//field[@name='target_id']" position="after"><field name="close_previous_id" invisible="operation != 'create'"/></xpath></field></record>
</odoo>
