ord>
  <record id="sales_line_search" model="ir.ui.view"><field name="name">vpr.sales.line.search</field><field name="model">vendor.price.revision.sales.line</field><field name="arch" type="xml"><search><field name="snapshot_id"/><field name="sale_order_id"/><field name="customer_id"/><field name="product_id" options="{'no_open': True}"/><filter name="confirmed" string="Confirmed" domain="[('demand_type','=','confirmed')]"/><filter name="conditional" string="Open Quotations" domain="[('demand_type','=','conditional')]"/><filter name="fixed" string="Fixed Price Verified" domain="[('price_protection','=','fixed_price_verified')]"/><filter name="adjustable" string="Adjustment Allowed Verified" domain="[('price_protection','=','price_adjustment_allowed_verified')]"/><filter name="review" string="Contract Review" domain="[('price_protection','in',['contract_review_required','price_protection_unknown','offer_validity_review'])]"/><filter name="incomplete" string="Discount / Tax / Quantity Review" domain="[('valuation_status','=','incomplete')]"/><filter name="fx" string="Missing FX" domain="[('company_sales_value','=',False),('valuation_status','=','verified')]"/><filter name="stale" string="Stale Allocation / Commercial Source" domain="[('snapshot_id.freshness','=','stale')]"/></search></field></record>
