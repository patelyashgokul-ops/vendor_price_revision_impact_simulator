  <record id="sales_snapshot_list" model="ir.ui.view"><field name="name">vpr.sales.snapshot.list</field><field name="model">vendor.price.revision.sales.snapshot</field><field name="arch" type="xml"><list create="false" edit="false" delete="false" limit="40"><field name="name"/><field name="company_id"/><field name="scenario"/><field name="version"/><field name="collected_at"/><field name="confirmed_line_count"/><field name="conditional_line_count"/><field name="exception_count"/><field name="state"/></list></field></record>
  <record id="sales_snapshot_form" model="ir.ui.view"><field name="name">vpr.sales.snapshot.form</field><field name="model">vendor.price.revision.sales.snapshot</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_check_current" type="object" string="Verify Current Sources"/></header><sheet><div class="alert alert-info" role="status">Commercial values for outstanding fulfillment. These are not recognized revenue, gross profit or vendor-cost exposure. Confirmed and conditional currencies/scenarios remain separate. Incomplete amounts are blank; known subtotals exclude incomplete lines. Full freshness requires authorized allocation access.</div><group><field name="name"/><field name="company_id"/><field name="warehouse_ids"/><field name="scenario"/><field name="version"/><field name="previous_id"/><field name="collected_at"/><field name="collected_by"/><field name="fx_date"/><field name="state"/><field name="freshness"/></group><notebook><page string="Exact Customer Lines"><field name="line_ids"><list create="false" edit="false" delete="false"><field name="sale_order_id"/><field name="customer_id"/><field name="product_id" options="{'no_open': True}"/><field name="demand_type"/><field name="source_order_state"/><field name="outstanding_qty"/><field name="comparison_uom_id"/><field name="source_unit_price"/><field name="source_discount_percent"/><field name="net_sales_unit_price"/><field name="outstanding_sales_value"/><field name="sales_currency_id"/><field name="price_protection"/><field name="valuation_status"/></list></field></page><page string="Currency / Commitment Groups"><field name="totals"/></page><page string="Full Order and Adjustment References"><field name="order_context"/></page><page string="Review Exceptions"><field name="issue_ids"><list create="false" edit="false" delete="false"><field name="sale_line_id"/><field name="code"/><field name="severity"/><field name="message"/></list></field></page><page string="Traceability"><group><field name="batch_source_id"/><field name="allocation_source_id"/><field name="allocation_version"/><field name="allocation_digest"/><field name="supply_source_id"/><field name="policy_version"/><field name="fingerprint"/></group></page></notebook></sheet></form></field></record>
  <record id="sales_line_list" model="ir.ui.view"><field name="name">vpr.sales.line.list</field><field name="model">vendor.price.revision.sales.line</field><field name="arch" type="xml"><list create="false" edit="false" delete="false" limit="40"><field name="snapshot_id"/><field name="sale_order_id"/><field name="customer_id"/><field name="product_id" options="{'no_open': True}"/><field name="demand_type"/><field name="outstanding_qty"/><field name="net_sales_unit_price"/><field name="outstanding_sales_value"/><field name="sales_currency_id"/><field name="price_protection"/><field name="valuation_status"/></list></field></record>
