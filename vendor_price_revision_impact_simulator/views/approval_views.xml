<?xml version='1.0' encoding='utf-8'?>
<odoo>
 <record id="view_ap_assignment_wizard" model="ir.ui.view"><field name="name">vpr.approval.assignment</field><field name="model">vendor.price.revision.approval.assignment.wizard</field><field name="arch" type="xml"><form><group><field name="request_id" readonly="1"/><field name="stage_code"/><field name="quorum" readonly="1"/><field name="candidate_ids" invisible="1"/><field name="assigned_ids" widget="many2many_tags" domain="[('id','in',candidate_ids)]"/></group><footer><button name="action_save" type="object" string="Save Eligible Reviewer Proposal"/><button special="cancel" string="Cancel"/></footer></form></field></record><record id="view_ap_request_list" model="ir.ui.view"><field name="name">vpr.approval.request.list</field><field name="model">vendor.price.revision.approval.request</field><field name="arch" type="xml"><list create="false" delete="false"><field name="name"/><field name="company_id"/><field name="request_type"/><field name="maker_id"/><field name="submitted_by"/><field name="submitted_at"/><field name="version"/><field name="state" string="Stored lifecycle (validate current sources)"/><field name="risk_severity"/></list></field></record>
 <record id="view_ap_request_form" model="ir.ui.view"><field name="name">vpr.approval.request.form</field><field name="model">vendor.price.revision.approval.request</field><field name="arch" type="xml">
  <form create="false" delete="false"><header>
   <button name="action_validate_request" type="object" string="Validate Prerequisites" invisible="state not in ['draft','blocked','ready_to_submit']"/>
   <button name="action_open_assignment" type="object" string="Assign Draft Reviewers" invisible="state not in ['draft','blocked','ready_to_submit']"/><button name="action_submit_for_review" type="object" string="Submit for Review (No Decision)" invisible="state not in ['draft','blocked','ready_to_submit']"/>
   <button name="action_refresh_readiness" type="object" string="Revalidate Current Sources and Reviewers"/>
   <button name="action_open_lifecycle" type="object" string="Withdrawal / New Version"/>
   <button name="action_open_source" type="object" string="Authorized Financial Source"/>
  </header><sheet><div class="alert alert-info">Routing is not approval, supplier acceptance or price authority. Only the first stage is ready; later stages await PR20 decisions. Submitted figures and candidate sets are historical evidence; current authorization must be revalidated.</div>
   <group><group><field name="name" readonly="1"/><field name="company_id" readonly="1"/><field name="revision_id" readonly="1"/><field name="request_type" readonly="1"/><field name="requested_by" readonly="1"/><field name="maker_id" readonly="1"/><field name="submitted_by" readonly="1"/><field name="submitted_at" readonly="1"/></group>
   <group><field name="state" readonly="1"/><field name="current_state" readonly="1"/><field name="currency_id" readonly="1"/><field name="financial_readiness" readonly="1"/><field name="risk_severity" readonly="1"/><field name="policy_id" readonly="1"/><field name="policy_version" readonly="1"/><field name="version" readonly="1"/><field name="previous_id" readonly="1"/></group></group>
   <field name="reason" readonly="state not in ['draft','blocked','ready_to_submit']"/>
   <group><field name="baseline_id" readonly="1"/><field name="scenario_id" readonly="1"/><field name="recommendation_id" readonly="1"/><field name="option_id" readonly="1"/><field name="evidence_id" readonly="1"/><field name="source_fingerprint" readonly="1"/><field name="submission_fingerprint" readonly="1"/><field name="stale_reason" readonly="1"/></group>
   <notebook><page string="Financial Basis"><field name="financial_values" readonly="1"/></page><page string="Sequential Review Plan"><field name="stage_ids" readonly="1"/></page><page string="Manual Assignment Proposal"><field name="manual_assignments" readonly="1"/><div>For a manual company policy, use Assign Draft Reviewers to choose current independent candidates for each required level. Submission checks the complete route again.</div></page><page string="Retained Blockers"><field name="issue_ids" readonly="1"/></page><page string="Immutable Audit"><field name="event_ids" readonly="1"/></page></notebook>
  </sheet></form>
 </field></record>
 <record id="view_ap_stage_list" model="ir.ui.view"><field name="name">vpr.approval.stage.list</field><field name="model">vendor.price.revision.approval.stage</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="request_id"/><field name="sequence"/><field name="code"/><field name="required_group_ids" widget="many2many_tags"/><field name="quorum"/><field name="assigned_ids" widget="many2many_tags"/><field name="stage_status"/><field name="policy_version"/></list></field></record>
 <record id="view_ap_stage_form" model="ir.ui.view"><field name="name">vpr.approval.stage.form</field><field name="model">vendor.price.revision.approval.stage</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><div class="alert alert-info">No decisions are available in PR19. Submitted candidate membership is not permanent authority.</div><group><field name="request_id"/><field name="company_id"/><field name="sequence"/><field name="code"/><field name="required_group_ids" widget="many2many_tags"/><field name="quorum"/><field name="candidate_ids" widget="many2many_tags"/><field name="assigned_ids" widget="many2many_tags"/><field name="stage_status"/><field name="effective_status"/><field name="assigned_by"/><field name="assigned_at"/><field name="policy_version"/><field name="activity_ids" widget="many2many_tags"/></group><field name="plan"/></sheet></form></field></record>
 <record id="view_ap_evidence_form" model="ir.ui.view"><field name="name">vpr.approval.evidence.form</field><field name="model">vendor.price.revision.approval.evidence</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><group><field name="request_id"/><field name="company_id"/><field name="actor_id"/><field name="recorded_at"/><field name="fingerprint"/></group><field name="data"/></sheet></form></field></record>
 <record id="view_ap_wizard" model="ir.ui.view"><field name="name">vpr.approval.prepare</field><field name="model">vendor.price.revision.approval.wizard</field><field name="arch" type="xml"><form><group><field name="baseline_id"/><field name="request_type"/><field name="scenario_id"/><field name="recommendation_id"/><field name="option_id"/><field name="reason"/></group><footer><button name="action_prepare" string="Create Source-Linked Draft" type="object" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
 <record id="view_ap_lifecycle_wizard" model="ir.ui.view"><field name="name">vpr.approval.lifecycle</field><field name="model">vendor.price.revision.approval.lifecycle.wizard</field><field name="arch" type="xml"><form><group><field name="request_id"/><field name="operation"/><field name="baseline_id" invisible="operation != 'new_version'"/><field name="scenario_id" invisible="operation != 'new_version'"/><field name="recommendation_id" invisible="operation != 'new_version'"/><field name="option_id" invisible="operation != 'new_version'"/><field name="reason"/></group><footer><button name="action_execute" type="object" string="Apply Lifecycle Action (No Decision)"/><button special="cancel" string="Cancel"/></footer></form></field></record>
 <record id="view_ap_source_button" model="ir.ui.view"><field name="name">vpr.approval.source.button</field><field name="model">vendor.price.revision.reconciliation.run</field><field name="inherit_id" ref="view_reconciliation_run_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_prepare_approval_request" type="object" string="Prepare Management Review"/></xpath></field></record>
 <record id="view_ap_config" model="ir.ui.view"><field name="name">vpr.approval.config</field><field name="model">vendor.price.revision.config</field><field name="inherit_id" ref="view_vpr_config_form"/><field name="arch" type="xml">
  <xpath expr="//notebook" position="inside"><page string="Management Review Routing"><group><field name="workflow_enabled" readonly="state != 'draft'"/><field name="workflow_types" readonly="state != 'draft'"/><field name="workflow_role_order" readonly="state != 'draft'"/><field name="workflow_assignment" readonly="state != 'draft'"/><field name="workflow_submitter_group_ids" widget="many2many_tags" readonly="state != 'draft'"/><field name="workflow_high_group_ids" widget="many2many_tags" readonly="state != 'draft'"/><field name="workflow_critical_group_ids" widget="many2many_tags" readonly="state != 'draft'"/><field name="workflow_contract_group_ids" widget="many2many_tags" readonly="state != 'draft'"/><field name="workflow_exclude_contributors" readonly="state != 'draft'"/><field name="workflow_manager_withdrawal" readonly="state != 'draft'"/><field name="workflow_activities" readonly="state != 'draft'"/><field name="workflow_due_days" readonly="state != 'draft'"/></group><div>PR04 intervals remain inclusive minimum / exclusive maximum. Use the next representable company-currency amount for an inclusive upper tier (e.g.10000.01 for a0..10000.00 tier). Metrics and risk/contract escalations are additive. Routing is disabled until explicitly configured and published.</div></page></xpath>
  <xpath expr="//field[@name='approval_ids']/list/field[@name='category']" position="after"><field name="workflow_types"/><field name="workflow_metric"/><field name="workflow_trigger"/><field name="workflow_named_reviewer_ids" widget="many2many_tags"/></xpath>
 </field></record>
 <record id="action_ap_requests" model="ir.actions.act_window"><field name="name">Management Review Requests</field><field name="res_model">vendor.price.revision.approval.request</field><field name="view_mode">list,form</field></record>
 <record id="action_ap_prepare" model="ir.actions.act_window"><field name="name">Prepare Review Request</field><field name="res_model">vendor.price.revision.approval.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
 <record id="action_ap_stages" model="ir.actions.act_window"><field name="name">Planned Review Routes</field><field name="res_model">vendor.price.revision.approval.stage</field><field name="view_mode">list,form</field></record>
 <record id="action_ap_evidence" model="ir.actions.act_window"><field name="name">Submitted Approval Evidence</field><field name="res_model">vendor.price.revision.approval.evidence</field><field name="view_mode">list,form</field></record>
 <record id="action_ap_pending" model="ir.actions.server"><field name="name">My Current Pending Reviews</field><field name="model_id" ref="model_vendor_price_revision_approval_request"/><field name="state">code</field><field name="code">action = model.action_my_pending_reviews()</field></record>
 <menuitem id="menu_approval_foundation" name="Management Review" parent="menu_vendor_price_simulator_root" sequence="80"/>
 <menuitem id="menu_ap_requests" name="Review Requests" parent="menu_approval_foundation" action="action_ap_requests" sequence="10"/>
 <menuitem id="menu_ap_prepare" name="Prepare Request" parent="menu_approval_foundation" action="action_ap_prepare" sequence="20"/>
 <menuitem id="menu_ap_pending" name="My Pending Reviews" parent="menu_approval_foundation" action="action_ap_pending" sequence="30"/>
 <menuitem id="menu_ap_stages" name="Planned Routes" parent="menu_approval_foundation" action="action_ap_stages" sequence="40"/>
 <menuitem id="menu_ap_evidence" name="Submitted Evidence" parent="menu_approval_foundation" action="action_ap_evidence" sequence="50"/>
</odoo>
