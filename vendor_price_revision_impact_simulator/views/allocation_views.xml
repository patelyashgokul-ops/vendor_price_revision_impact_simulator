<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_batch_allocation" model="ir.ui.view"><field name="name">vpr.batch.allocation</field><field name="model">vendor.price.revision.import.batch</field><field name="inherit_id" ref="view_import_batch_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_open_allocation" type="object" string="Allocate Demand (Simulation)" groups="vendor_price_revision_impact_simulator.group_vendor_price_revision_user" invisible="state != 'extracted'"/></xpath><xpath expr="//notebook" position="inside"><page string="Supply and Demand Allocation"><div class="alert alert-info" role="status">Analytical quantity allocation only. No stock is reserved. Confirmed commitments and independent conditional scenarios must not be added together. Unknown quantities remain unresolved.</div><field name="allocation_snapshot_ids" readonly="True"><list create="false" edit="false" delete="false" limit="20"><field name="scenario"/><field name="warehouse_ids"/><field name="collected_at"/><field name="version"/><field name="state"/></list></field></page></xpath></field></record>
<record id="view_allocation_snapshot_list" model="ir.ui.view"><field name="name">view_allocation_snapshot_list</field><field name="model">vendor.price.revision.allocation.snapshot</field><field name="arch" type="xml"><list create="false" edit="false" delete="false" limit="20"><field name="batch_id"/><field name="scenario"/><field name="warehouse_ids"/><field name="collected_at"/><field name="version"/><field name="state"/></list></field></record>
<record id="view_allocation_snapshot_form" model="ir.ui.view"><field name="name">view_allocation_snapshot_form</field><field name="model">vendor.price.revision.allocation.snapshot</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_check_current" type="object" string="Check Current Sources"/></header><sheet><group><field name="batch_id"/><field name="scenario"/><field name="warehouse_ids"/><field name="contains_costs"/><field name="supply_snapshot_id"/><field name="baseline_id"/><field name="collected_at"/><field name="collected_by"/><field name="version"/><field name="previous_id"/><field name="state"/><field name="freshness"/><field name="fingerprint"/></group><notebook><page string="Exact Sales Demand"><field name="demand_ids"><list create="false" edit="false" delete="false" limit="40"><field name="order_name"/><field name="product_name"/><field name="warehouse_id"/><field name="uom_id"/><field name="demand_type"/><field name="outstanding"/><field name="required_date"/><field name="reserved"/><field name="free_stock"/><field name="incoming"/><field name="protected_incoming"/><field name="new_procurement"/><field name="unresolved"/><field name="status"/></list></field></page><page string="Simulated Consumption Ledger"><field name="entry_ids"><list create="false" edit="false" delete="false" limit="40"><field name="demand_id"/><field name="capacity_key"/><field name="allocation_type"/><field name="quantity"/><field name="available_date"/><field name="required_date"/><field name="cost_confidence"/><field name="supply_bucket_id"/></list></field></page><page string="Per Product / Warehouse / Scenario Totals"><field name="totals"/></page><page string="Remaining Capacity"><field name="source_capacities"/></page><page string="Review Issues"><field name="issue_ids"><list create="false" edit="false" delete="false"><field name="code"/><field name="source_key"/><field name="severity"/><field name="message"/></list></field></page><page string="Frozen Evidence"><field name="scope"/><field name="provenance"/></page></notebook></sheet></form></field></record>
<record id="view_allocation_demand_form" model="ir.ui.view"><field name="name">view_allocation_demand_form</field><field name="model">vendor.price.revision.allocation.demand</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_open_source" type="object" string="Open Sales Source (native permissions)"/></header><sheet><group><field name="snapshot_id"/><field name="source_key"/><field name="sale_order_id"/><field name="sale_line_id"/><field name="order_name"/><field name="customer_id"/><field name="product_id"/><field name="product_name"/><field name="warehouse_id"/><field name="uom_id"/><field name="demand_type"/><field name="ordered"/><field name="delivered"/><field name="outstanding"/><field name="required_date"/><field name="date_basis"/><field name="reserved"/><field name="free_stock"/><field name="incoming"/><field name="protected_incoming"/><field name="new_procurement"/><field name="unresolved"/><field name="priority"/><field name="status"/><field name="issues"/><field name="source_fingerprint"/></group></sheet></form></field></record>
<record id="view_allocation_entry_form" model="ir.ui.view"><field name="name">view_allocation_entry_form</field><field name="model">vendor.price.revision.allocation.entry</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><group><field name="snapshot_id"/><field name="demand_id"/><field name="demand_source_key"/><field name="capacity_key"/><field name="supply_bucket_id"/><field name="allocation_type"/><field name="quantity"/><field name="available_date"/><field name="required_date"/><field name="cost_confidence"/></group><field name="source_evidence"/></sheet></form></field></record>
<record id="view_allocation_search" model="ir.ui.view"><field name="name">view_allocation_search</field><field name="model">vendor.price.revision.allocation.snapshot</field><field name="arch" type="xml"><search><field name="batch_id"/><field name="scenario"/><field name="state"/><filter name="confirmed" string="Confirmed Baseline" domain="[('scenario','=','confirmed_baseline')]"/><filter name="conditional" string="Conditional Quotations" domain="[('scenario','!=','confirmed_baseline')]"/><filter name="review" string="Review Required" domain="[('state','=','review_required')]"/><filter name="covered" string="Fully Covered" domain="[('demand_ids.status','=','fully_covered')]"/><filter name="partial" string="Partially Covered" domain="[('demand_ids.status','=','partially_covered')]"/><filter name="uncovered" string="Uncovered" domain="[('demand_ids.status','=','uncovered')]"/><filter name="late" string="Late Potential Supply" domain="[('issue_ids.code','=','ARRIVAL_AFTER_REQUIRED_DATE')]"/><filter name="stale" string="Stale Sources" domain="[('freshness','=','stale')]"/></search></field></record>
<record id="view_allocation_wizard" model="ir.ui.view"><field name="name">view_allocation_wizard</field><field name="model">vendor.price.revision.allocation.wizard</field><field name="arch" type="xml"><form><group><field name="batch_id"/><field name="company_id"/><field name="warehouse_ids"/><field name="costs"/><field name="horizon"/><field name="confirmed_order_ids"/><field name="quotation_ids"/><field name="portfolio_reason"/><field name="candidate_sources"/></group><footer><button name="action_preview_sources" type="object" string="Preview Authorized Sales Sources"/><button name="action_run" type="object" string="Run Analytical Allocation" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
<record id="view_allocation_policy_list" model="ir.ui.view"><field name="name">view_allocation_policy_list</field><field name="model">vendor.price.revision.allocation.policy</field><field name="arch" type="xml"><list delete="false"><field name="company_id"/><field name="active"/><field name="version"/><field name="priority"/><field name="allow_receiving_buffer"/><field name="receiving_buffer_hours"/><field name="reason"/></list></field></record>
<record id="view_allocation_policy_form" model="ir.ui.view"><field name="name">view_allocation_policy_form</field><field name="model">vendor.price.revision.allocation.policy</field><field name="arch" type="xml"><form delete="false"><sheet><group><field name="company_id"/><field name="active"/><field name="version"/><field name="priority"/><field name="allow_receiving_buffer"/><field name="receiving_buffer_hours"/><field name="reason"/></group><div class="alert alert-info" role="status">Actual reservations and direct procurement ownership are preserved. Only same-warehouse timely quantities are allocated. Missing dates and ambiguous supply remain unresolved. Default priority is earliest required date, confirmation date, stable source line ID.</div></sheet></form></field></record>
<record id="action_allocation_policy" model="ir.actions.act_window"><field name="name">Analytical Allocation Policy</field><field name="res_model">vendor.price.revision.allocation.policy</field><field name="view_mode">list,form</field></record><menuitem id="menu_allocation_policy" name="Allocation Policy" parent="menu_vpr_configuration" action="action_allocation_policy" groups="group_vpr_configuration_admin"/>
<record id="view_supply_grant_demand" model="ir.ui.view"><field name="name">vpr.supply.grant.demand</field><field name="model">vendor.price.revision.supply.grant</field><field name="inherit_id" ref="view_supply_grant_form"/><field name="arch" type="xml"><xpath expr="//field[@name='allow_cost']" position="after"><field name="allow_demand"/></xpath></field></record>
</odoo>