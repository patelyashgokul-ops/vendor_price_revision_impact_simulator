<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_scenario_list" model="ir.ui.view"><field name="name">vpr.scenario.list</field><field name="model">vendor.price.revision.scenario</field><field name="arch" type="xml"><list create="false" edit="false" delete="false" limit="20"><field name="name"/><field name="company_id"/><field name="vendor_id"/><field name="baseline_id"/><field name="selection_status"/></list></field></record>
 <record id="view_scenario_form" model="ir.ui.view"><field name="name">vpr.scenario.form</field><field name="model">vendor.price.revision.scenario</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header>
  <button name="action_open_inputs" type="object" string="Version Assumptions" groups="vendor_price_revision_impact_simulator.group_vpr_finance_manager"/>
  <button name="action_calculate_view" type="object" string="Calculate Hypothetical Result" groups="vendor_price_revision_impact_simulator.group_vpr_finance_manager"/>
  <button name="action_open_clone" type="object" string="Clone Alternative" groups="vendor_price_revision_impact_simulator.group_vpr_finance_manager"/>
  <button name="action_open_selection" type="object" string="Analytical Selection" groups="vendor_price_revision_impact_simulator.group_vpr_finance_manager"/>
  <button name="action_open_baseline" type="object" string="Source Reconciliation"/>
 </header><sheet><div class="alert alert-info" role="status">Hypothetical alternatives are never additive. Financial verification is analytical evidence, not supplier acceptance, management approval or price application. Source stock, commitments and customer prices remain authoritative.</div>
 <group><field name="name"/><field name="company_id"/><field name="vendor_id"/><field name="batch_id"/><field name="baseline_id"/><field name="parent_id"/><field name="currency_id"/><field name="current_state"/><field name="selection_status"/></group>
 <notebook><page string="Input Versions"><field name="input_ids"/></page><page string="Result History"><field name="result_ids"/></page><page string="Selection Audit"><field name="event_ids"/></page></notebook></sheet></form></field></record>
 <record id="view_scenario_result_list" model="ir.ui.view"><field name="name">vpr.scenario.result.list</field><field name="model">vendor.price.revision.scenario.result</field><field name="arch" type="xml"><list create="false" edit="false" delete="false" limit="40" default_order="projected_cost asc"><field name="scenario_id"/><field name="version"/><field name="state"/><field name="complete"/><field name="currency_id"/><field name="cost_known" column_invisible="True"/><field name="projected_cost" invisible="not cost_known"/><field name="improvement_vs_proposal"/><field name="projected_profit"/><field name="projected_margin"/><field name="margin_improvement_points"/><field name="risk_status"/><field name="collected_at"/></list></field></record>
 <record id="view_scenario_result_form" model="ir.ui.view"><field name="name">vpr.scenario.result.form</field><field name="model">vendor.price.revision.scenario.result</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><div class="alert alert-warning" role="status">Stored historical calculation. Open the scenario to check current sources before comparison or selection. Potential improvement is not realized savings.</div><group><field name="scenario_id"/><field name="input_id"/><field name="version"/><field name="previous_id"/><field name="currency_id"/><field name="state"/><field name="complete"/><field name="cost_known"/><field name="projected_cost" invisible="not cost_known"/><field name="projected_profit"/><field name="projected_margin"/><field name="improvement_vs_proposal"/><field name="margin_improvement_points"/><field name="risk_status"/><field name="collected_at"/><field name="actor_id"/></group><notebook><page string="Financial Evidence"><field name="financial"/><field name="detail_ids"/></page><page string="Profit and Risk"><field name="profit"/></page><page string="Controls and Issues"><field name="controls"/><field name="issues"/></page><page string="Sources and Changed Assumptions"><field name="provenance"/><field name="fingerprint"/></page></notebook></sheet></form></field></record>
 <record id="view_scenario_input_form" model="ir.ui.view"><field name="name">vpr.scenario.input.form</field><field name="model">vendor.price.revision.scenario.input</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><group><field name="scenario_id"/><field name="version"/><field name="previous_id"/><field name="reason"/><field name="actor_id"/><field name="recorded_at"/><field name="fingerprint"/></group><field name="line_ids"/></sheet></form></field></record>
 <record id="view_scenario_line_form" model="ir.ui.view"><field name="name">vpr.scenario.line.form</field><field name="model">vendor.price.revision.scenario.line</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><group><field name="input_id"/><field name="product_id"/><field name="po_line_id"/><field name="mode"/></group><field name="values"/></sheet></form></field></record>
 <record id="view_scenario_create_wizard" model="ir.ui.view"><field name="name">vpr.scenario.create.wizard</field><field name="model">vendor.price.revision.scenario.create.wizard</field><field name="arch" type="xml"><form><group><field name="baseline_id" readonly="1"/><field name="parent_id" readonly="1"/><field name="name"/></group><footer><button name="action_create" type="object" string="Create Hypothetical Alternative" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
 <record id="view_scenario_wizard" model="ir.ui.view"><field name="name">vpr.scenario.wizard</field><field name="model">vendor.price.revision.scenario.wizard</field><field name="arch" type="xml"><form><group><field name="scenario_id" readonly="1"/><field name="product_id"/><field name="source_basis" readonly="1"/><field name="mode"/><field name="value" invisible="mode in ('original','tier')"/><field name="discount_base" invisible="mode not in ('fixed_discount','percent_discount')"/><field name="row_id" invisible="mode != 'tier'"/><field name="grouped" invisible="mode != 'tier'"/><field name="group_reason" invisible="not grouped"/><field name="fx_method"/><field name="fx_rate" invisible="fx_method == 'price_only_common_fx'"/><field name="fx_date" invisible="fx_method == 'price_only_common_fx'"/><field name="effective_date"/><field name="commitment_date"/><field name="timing_evidence"/><field name="po_line_id"/><field name="po_evidence"/><field name="landed_components"/><field name="reason"/></group><footer><button name="action_save" type="object" string="Retain New Input Version" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
 <record id="view_scenario_selection_wizard" model="ir.ui.view"><field name="name">vpr.scenario.selection.wizard</field><field name="model">vendor.price.revision.scenario.selection.wizard</field><field name="arch" type="xml"><form><group><field name="scenario_id" readonly="1"/><field name="event"/><field name="reason"/></group><footer><button name="action_record" type="object" string="Record Analytical Selection"/><button special="cancel" string="Cancel"/></footer></form></field></record>
 <record id="view_reconciliation_scenario_button" model="ir.ui.view"><field name="name">vpr.reconciliation.scenario.button</field><field name="model">vendor.price.revision.reconciliation.run</field><field name="inherit_id" ref="view_reconciliation_run_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_open_vendor_scenario" type="object" string="Create What-If Alternative" groups="vendor_price_revision_impact_simulator.group_vpr_finance_manager"/></xpath></field></record>
 <record id="action_scenarios" model="ir.actions.act_window"><field name="name">What-If Vendor Scenarios</field><field name="res_model">vendor.price.revision.scenario</field><field name="view_mode">list,form</field></record>
 <record id="action_scenario_compare" model="ir.actions.server"><field name="name">Compare Current Hypothetical Alternatives</field><field name="model_id" ref="model_vendor_price_revision_scenario"/><field name="binding_model_id" ref="model_vendor_price_revision_scenario"/><field name="binding_view_types">list</field><field name="state">code</field><field name="code">action = records.action_compare_scenarios()</field></record>
 <menuitem id="menu_scenarios" name="What-If Scenarios" parent="menu_financial_analysis" action="action_scenarios" sequence="40"/>
 <record id="view_scenario_landed_policy" model="ir.ui.view"><field name="name">vpr.scenario.landed.policy</field><field name="model">vendor.price.revision.config</field><field name="inherit_id" ref="view_vpr_config_form"/><field name="arch" type="xml"><xpath expr="//field[@name='additional_cost_policy']" position="after"><field name="scenario_landed_policy" readonly="state != 'draft'"/></xpath></field></record>
</odoo>
