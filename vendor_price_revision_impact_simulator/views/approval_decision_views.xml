<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_ap20_request_list" model="ir.ui.view"><field name="name">vpr.approval.historical.state.validity</field><field name="model">vendor.price.revision.approval.request</field><field name="inherit_id" ref="view_ap_request_list"/><field name="arch" type="xml"><xpath expr="//field[@name='state']" position="attributes"><attribute name="string">Historical Lifecycle</attribute></xpath><xpath expr="//field[@name='risk_severity']" position="after"><field name="approval_valid_until"/><field name="approval_invalidated_at"/><field name="approval_expired_at"/></xpath></field></record>
 <record id="view_ap20_request" model="ir.ui.view"><field name="name">vpr.approval.decision.request</field><field name="model">vendor.price.revision.approval.request</field><field name="inherit_id" ref="view_ap_request_form"/><field name="arch" type="xml">
  <xpath expr="//header" position="inside">
   <field name="can_decide" invisible="1"/>
   <button name="action_open_approve" type="object" string="Approve" invisible="not can_decide" class="btn-primary"/>
   <button name="action_open_reject" type="object" string="Reject" invisible="not can_decide"/>
   <button name="action_open_return" type="object" string="Return for Revision" invisible="not can_decide"/>
   <button name="action_revalidate_approval" type="object" string="Revalidate Authority" invisible="state not in ['awaiting_review','partially_approved','approved']"/>
   <button name="action_open_delegation" type="object" string="Propose Delegation" invisible="state not in ['awaiting_review','partially_approved']"/>
   <button name="action_open_invalidation" type="object" string="Governance Invalidation" invisible="state not in ['awaiting_review','partially_approved','approved']"/>
  </xpath>
  <xpath expr="//sheet/div[contains(@class,'alert')]" position="replace"><div class="alert alert-info">APPROVED DOES NOT MEAN APPLIED. Management authorization covers only the exact submitted commercial subject. Supplier/customer acceptance and any later application require separate checks. Historical decisions remain visible after expiration or invalidation.</div></xpath>
  <xpath expr="//notebook" position="inside">
   <page string="Decision Authority"><group><field name="current_validity" readonly="1"/><field name="authorization_id" readonly="1"/><field name="approved_at" readonly="1"/><field name="approved_by" readonly="1"/><field name="approval_valid_from" readonly="1"/><field name="approval_valid_until" readonly="1"/><field name="review_deadline" readonly="1"/><field name="approval_invalidated_at" readonly="1"/><field name="approval_expired_at" readonly="1"/><field name="approval_invalidation_reason" readonly="1"/><field name="superseded_by_id" readonly="1"/></group><field name="review_display_note"/><field name="decision_ids" readonly="1"/><field name="delegation_ids" readonly="1"/></page>
   <page string="Exact Authorized Subject"><field name="payload_fingerprint" readonly="1"/><field name="submitted_payload" readonly="1"/><field name="decision_policy_fingerprint" readonly="1"/><field name="decision_policy" readonly="1"/></page>
  </xpath>
 </field></record>
 <record id="view_ap20_stage" model="ir.ui.view"><field name="name">vpr.approval.stage.quorum</field><field name="model">vendor.price.revision.approval.stage</field><field name="inherit_id" ref="view_ap_stage_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group><field name="historical_approval_count" readonly="1"/><field name="current_approval_count" readonly="1"/><field name="remaining_approval_count" readonly="1"/></group><field name="decision_ids" readonly="1"/></xpath></field></record>
 <record id="view_ap20_decision_list" model="ir.ui.view"><field name="name">vpr.approval.decisions</field><field name="model">vendor.price.revision.approval.decision</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="request_id"/><field name="company_id"/><field name="request_version"/><field name="stage_sequence"/><field name="decision_type"/><field name="reviewer_id"/><field name="acting_user_id"/><field name="delegation_id"/><field name="decided_at"/><field name="resulting_stage_status"/></list></field></record>
 <record id="view_ap20_decision_form" model="ir.ui.view"><field name="name">vpr.approval.decision</field><field name="model">vendor.price.revision.approval.decision</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><group><field name="request_id"/><field name="company_id"/><field name="stage_id"/><field name="decision_type"/><field name="reviewer_id"/><field name="acting_user_id"/><field name="delegation_id"/><field name="decided_at"/><field name="reason"/><field name="evidence_reference"/><field name="attachment_ids" widget="many2many_tags" options="{'no_create': True}"/><field name="policy_version"/><field name="request_version"/><field name="source_fingerprint"/><field name="submission_fingerprint"/><field name="fingerprint"/></group><field name="evidence"/></sheet></form></field></record>
 <record id="view_ap20_authorization_list" model="ir.ui.view"><field name="name">vpr.approval.authorizations</field><field name="model">vendor.price.revision.approval.authorization</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="request_id"/><field name="company_id"/><field name="request_type"/><field name="approved_at"/><field name="final_actor_id"/><field name="valid_from"/><field name="valid_until"/></list></field></record>
 <record id="view_ap20_authorization_form" model="ir.ui.view"><field name="name">vpr.approval.authorization</field><field name="model">vendor.price.revision.approval.authorization</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><div class="alert alert-info">Historical management authorization. Use current request validity before any separately implemented future application.</div><group><field name="request_id"/><field name="company_id"/><field name="request_type"/><field name="approved_at"/><field name="final_actor_id"/><field name="valid_from"/><field name="valid_until"/><field name="source_fingerprint"/><field name="payload_fingerprint"/><field name="fingerprint"/></group><field name="decision_ids"/><field name="evidence"/></sheet></form></field></record>
 <record id="view_ap20_delegation_list" model="ir.ui.view"><field name="name">vpr.approval.delegations</field><field name="model">vendor.price.revision.approval.delegation</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="request_id"/><field name="company_id"/><field name="stage_id"/><field name="principal_id"/><field name="delegate_id"/><field name="permitted_group_id"/><field name="effective_from"/><field name="effective_until"/><field name="state"/></list></field></record>
 <record id="view_ap20_delegation_form" model="ir.ui.view"><field name="name">vpr.approval.delegation</field><field name="model">vendor.price.revision.approval.delegation</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_authorize" type="object" string="Authorize Delegation" invisible="state != 'proposed'"/><button name="action_open_revocation" type="object" string="Revoke Delegation" invisible="state == 'revoked'"/></header><sheet><group><field name="request_id"/><field name="company_id"/><field name="stage_id"/><field name="principal_id"/><field name="delegate_id"/><field name="permitted_group_id"/><field name="request_type"/><field name="effective_from"/><field name="effective_until"/><field name="reason"/><field name="state"/><field name="proposed_by"/><field name="proposed_at"/><field name="authorized_by"/><field name="authorized_at"/><field name="revoked_by"/><field name="revoked_at"/><field name="revocation_reason"/></group></sheet></form></field></record>
 <record id="view_ap20_decision_wizard" model="ir.ui.view"><field name="name">vpr.approval.decision.input</field><field name="model">vendor.price.revision.approval.decision.wizard</field><field name="arch" type="xml"><form><group><field name="request_id" readonly="1"/><field name="stage_id" readonly="1"/><field name="decision_type" readonly="1"/><field name="delegation_id" domain="[('request_id','=',request_id),('stage_id','=',stage_id),('state','=','active')]"/><field name="reason"/><field name="evidence_reference"/><field name="attachment_ids" widget="many2many_tags" domain="[('res_model','=','vendor.price.revision.approval.request'),('res_id','=',request_id)]" options="{'no_create': True}"/></group><footer><button name="action_execute" type="object" string="Record Authenticated Decision" class="btn-primary" confirm="Record this management decision for the exact submitted subject? No prices will be applied."/><button special="cancel" string="Cancel"/></footer></form></field></record>
 <record id="view_ap20_delegation_wizard" model="ir.ui.view"><field name="name">vpr.approval.delegation.input</field><field name="model">vendor.price.revision.approval.delegation.wizard</field><field name="arch" type="xml"><form><group><field name="request_id" readonly="1"/><field name="stage_id" domain="[('request_id','=',request_id)]"/><field name="delegate_id"/><field name="permitted_group_id"/><field name="effective_from"/><field name="effective_until"/><field name="reason"/></group><footer><button name="action_propose" type="object" string="Propose for Independent Authorization"/><button special="cancel" string="Cancel"/></footer></form></field></record>
 <record id="view_ap20_governance_wizard" model="ir.ui.view"><field name="name">vpr.approval.governance.input</field><field name="model">vendor.price.revision.approval.governance.wizard</field><field name="arch" type="xml"><form><group><field name="request_id" readonly="1"/><field name="operation" readonly="1"/><field name="delegation_id" readonly="1" invisible="operation != 'revoke'"/><field name="reason"/></group><footer><button name="action_execute" type="object" string="Record Reasoned Governance Action"/><button special="cancel" string="Cancel"/></footer></form></field></record>
 <record id="view_ap20_config" model="ir.ui.view"><field name="name">vpr.approval.decision.policy</field><field name="model">vendor.price.revision.config</field><field name="inherit_id" ref="view_vpr_config_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Approval Decision Policy"><group><field name="decision_enabled" readonly="state != 'draft'"/><field name="decision_require_reason" readonly="state != 'draft'"/><field name="decision_review_hours" readonly="state != 'draft'"/><field name="decision_validity_mode" readonly="state != 'draft'"/><field name="decision_valid_days" readonly="state != 'draft'"/><field name="decision_valid_date" readonly="state != 'draft'"/><field name="decision_timezone" readonly="state != 'draft'"/><field name="decision_delegation_enabled" readonly="state != 'draft'"/><field name="decision_governance_group_ids" widget="many2many_tags" readonly="state != 'draft'"/></group><div>Decisions require explicit publication and a newly frozen decision contract. Days mean elapsed24-hour periods from final approval. A date ends at exclusive next local midnight in the configured timezone. Source freshness is always required.</div></page></xpath></field></record>
 <record id="action_ap20_decisions" model="ir.actions.act_window"><field name="name">Decision History</field><field name="res_model">vendor.price.revision.approval.decision</field><field name="view_mode">list,form</field></record>
 <record id="action_ap20_authorizations" model="ir.actions.act_window"><field name="name">Historical Final Authorizations</field><field name="res_model">vendor.price.revision.approval.authorization</field><field name="view_mode">list,form</field></record>
 <record id="action_ap20_delegations" model="ir.actions.act_window"><field name="name">Delegation Management</field><field name="res_model">vendor.price.revision.approval.delegation</field><field name="view_mode">list,form</field></record>
 <record id="action_ap20_returned" model="ir.actions.act_window"><field name="name">Returned Requests</field><field name="res_model">vendor.price.revision.approval.request</field><field name="view_mode">list,form</field><field name="domain">[('state','=','returned_for_revision')]</field></record>
 <record id="action_ap20_rejected" model="ir.actions.act_window"><field name="name">Rejected Requests</field><field name="res_model">vendor.price.revision.approval.request</field><field name="view_mode">list,form</field><field name="domain">[('state','=','rejected')]</field></record>
 <record id="action_ap20_approved" model="ir.actions.act_window"><field name="name">Approved History / Current Validity</field><field name="res_model">vendor.price.revision.approval.request</field><field name="view_mode">list,form</field><field name="domain">[('state','=','approved')]</field></record>
 <record id="action_ap20_invalid" model="ir.actions.act_window"><field name="name">Expired / Invalidated Review Authority</field><field name="res_model">vendor.price.revision.approval.request</field><field name="view_mode">list,form</field><field name="domain">['|','|',('state','in',['approval_expired','approval_invalidated']),('approval_expired_at','!=',False),('approval_invalidated_at','!=',False)]</field></record>
 <menuitem id="menu_ap20_decisions" name="Decision History" parent="menu_approval_foundation" action="action_ap20_decisions" sequence="60"/>
 <menuitem id="menu_ap20_authorizations" name="Final Authorization History" parent="menu_approval_foundation" action="action_ap20_authorizations" sequence="65"/>
 <menuitem id="menu_ap20_delegations" name="Delegations" parent="menu_approval_foundation" action="action_ap20_delegations" sequence="70"/>
 <menuitem id="menu_ap20_returned" name="Returned Requests" parent="menu_approval_foundation" action="action_ap20_returned" sequence="80"/>
 <menuitem id="menu_ap20_rejected" name="Rejected Requests" parent="menu_approval_foundation" action="action_ap20_rejected" sequence="90"/>
 <menuitem id="menu_ap20_approved" name="Approved Requests" parent="menu_approval_foundation" action="action_ap20_approved" sequence="100"/>
 <record id="action_ap20_invalid_current" model="ir.actions.server"><field name="name">Current Expired / Invalidated Authority</field><field name="model_id" ref="model_vendor_price_revision_approval_request"/><field name="state">code</field><field name="code">action = model.action_expired_invalidated_reviews()</field></record>
 <menuitem id="menu_ap20_invalid" name="Expired / Invalidated" parent="menu_approval_foundation" action="action_ap20_invalid_current" sequence="110"/>
</odoo>
