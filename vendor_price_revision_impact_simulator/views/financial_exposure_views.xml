<record id="view_financial_snapshot_search" model="ir.ui.view"><field name="name">vpr.financial.snapshot.search</field><field name="model">vendor.price.revision.financial.snapshot</field><field name="arch" type="xml"><search><field name="batch_id"/><field name="company_id"/><field name="state"/><field name="scenario"/><filter name="confirmed" string="Confirmed Baselines" domain="[('scenario','=','confirmed_baseline')]"/><filter name="conditional" string="Conditional Scenarios" domain="[('scenario','!=','confirmed_baseline')]"/><filter name="incomplete" string="Incomplete Cost Totals" domain="[('cost_complete','=',False)]"/></search></field></record>
<record id="view_financial_wizard" model="ir.ui.view"><field name="name">vpr.financial.wizard</field><field name="model">vendor.price.revision.financial.wizard</field><field name="arch" type="xml"><form><group><field name="batch_id"/><field name="company_id" invisible="True"/><field name="cost_source_id"/><field name="sales_source_id"/><field name="confirmed_source_id"/><field name="fx_method"/></group><div class="alert alert-info" role="status">Use current cost attribution and sales classification for the same allocation. Quotation scenarios also require their current confirmed financial baseline. No source records will be repriced.</div><footer><button name="action_run" type="object" string="Calculate Projected Exposure" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
<record id="action_financial_snapshots" model="ir.actions.act_window"><field name="name">Projected Financial Exposure</field><field name="res_model">vendor.price.revision.financial.snapshot</field><field name="view_mode">list,form</field></record>
