<record id="view_financial_line_list" model="ir.ui.view"><field name="name">vpr.financial.line.list</field><field name="model">vendor.price.revision.financial.line</field><field name="arch" type="xml"><list create="false" edit="false" delete="false" limit="40"><field name="snapshot_id"/><field name="order_name"/><field name="product_name"/><field name="demand_type"/><field name="source_type"/><field name="quantity"/><field name="comparison_uom_id"/><field name="currency_id"/><field name="baseline_unit_cost"/><field name="revised_unit_cost"/><field name="incremental_extended_cost"/><field name="direction"/><field name="status"/></list></field></record>
