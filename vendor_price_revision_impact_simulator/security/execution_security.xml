  </record>
  <record id="ex22_confirmation_owner" model="ir.access">
    <field name="name">ex22_confirmation_owner</field>
    <field name="operation">crud</field>
    <field name="domain">[('create_uid','=',user.id)] if user.active else [('id','=',0)]</field>
    <field name="model_id" ref="model_vendor_price_revision_application_confirmation" />
    <field name="group_id" eval="False" />
  </record>
</odoo>